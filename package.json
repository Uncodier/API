{
  "name": "api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "ws": "node wsServer.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run ws\"",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "postbuild": "node scripts/build-search-index.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:dependencies": "node --test __tests__/dependencies/security-upgrade.test.mjs",
    "test:search-index": "node --test __tests__/build/search-index.test.mjs",
    "test:tasks": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.tasks.config.js --runInBand",
    "test:upgrade-regressions": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.upgrade-regressions.config.js --runInBand",
    "test:harness": "node ./node_modules/jest/bin/jest.js --config jest.harness.config.js --runInBand",
    "test:harness:agent": "node ./node_modules/jest/bin/jest.js --config jest.agent-harness.config.js --runInBand",
    "test:harness:cloud": "node ./node_modules/jest/bin/jest.js --config jest.cloud-files.config.js --runInBand && node --test src/lib/cloud-files/__tests__/*.test.mjs",
    "test:procurement": "node ./node_modules/jest/bin/jest.js --config jest.procurement.config.js --runInBand",
    "test:harness:cloud:contracts": "node scripts/harness-cloud-contracts.mjs",
    "test:harness:cloud:unit": "node --test __tests__/harness-cloud/contracts.test.mjs",
    "test:assistant-runtime": "node ./node_modules/jest/bin/jest.js --config jest.assistant-runtime.config.js --runInBand && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.assistant-runtime-esm.config.js --runInBand",
    "test:commands": "node ./node_modules/jest/bin/jest.js --config jest.commands.config.js --runInBand",
    "test:voice": "node ./node_modules/jest/bin/jest.js --config jest.voice.config.js --runInBand",
    "test:transactional-email": "node ./node_modules/jest/bin/jest.js --config jest.transactional-email.config.js --runInBand",
    "test:scheduling": "node ./node_modules/jest/bin/jest.js --config jest.scheduling.config.js --runInBand",
    "test:ai": "node ./node_modules/jest/bin/jest.js --config jest.ai.config.js --runInBand",
    "test:catalog-search": "node ./node_modules/jest/bin/jest.js --config jest.catalog-search.config.js --runInBand && node --test --test-concurrency=1 __tests__/catalog/catalog-search-sql.test.mjs __tests__/catalog/catalog-search-scale.test.mjs __tests__/catalog/catalog-search-semantic-recall.test.mjs __tests__/catalog/catalog-search-postgres.test.mjs __tests__/catalog/catalog-search-visibility.test.mjs",
    "test:target-processor": "jest --verbose src/lib/agentbase/agents/tests/TargetProcessorAgent.test.ts",
    "test:array-fix": "tsx ./scripts/test-array-fix.ts",
    "test:contents-structure": "jest --verbose -t \"should maintain array structure for single-object targets\"",
    "validate-format": "node ./scripts/validate-format.js",
    "test:target-array-fix": "npm run validate-format && echo '✅ Format validation passed. Full test suite requires Jest.'",
    "validate-real-case": "node ./scripts/validate-real-case.js",
    "diagnose-validation": "node ./scripts/diagnose-db-validation.js",
    "test:respect-structure": "node ./scripts/test-db-adapter-fix.js",
    "test:content-calendar": "tsx src/app/api/agents/copywriter/content-calendar/tests/run-test.ts",
    "test:content-extraction": "tsx src/app/api/agents/copywriter/content-calendar/tests/quick-test.ts",
    "test:calendar-jest": "jest --verbose src/app/api/agents/copywriter/content-calendar/__tests__",
    "test:chat-message": "jest --verbose src/tests/api/agents-chat-message.test.ts",
    "status:probe": "tsx scripts/run-system-probes.ts",
    "test:status": "node ./node_modules/jest/bin/jest.js --config jest.status.config.js --runInBand && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.status-cron.config.js --runInBand",
    "test:mcp": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.mcp.config.js --runInBand && node ./node_modules/jest/bin/jest.js --config jest.mcp-security.config.js --runInBand && npm run test:procurement",
    "mcp": "tsx mcp-server/index.ts"
  },
  "dependencies": {
    "@agent-browser/sandbox": "0.38.1",
    "@ai-sdk/openai": "4.0.16",
    "@breezystack/lamejs": "1.2.7",
    "@google/genai": "1.25.0",
    "@google/generative-ai": "0.24.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "^3.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@rrweb/rrweb-plugin-console-record": "2.1.4",
    "@sendgrid/mail": "^8.1.5",
    "@sparticuz/chromium": "143.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.1.5",
    "@tailwindcss/typography": "^0.5.10",
    "@temporalio/client": "^1.11.8",
    "@types/crypto-js": "^4.2.2",
    "@types/ws": "^8.18.1",
    "@vapi-ai/server-sdk": "^0.6.4",
    "@vercel/sandbox": "3.2.1",
    "ai": "7.0.31",
    "axios": "^1.20.0",
    "cheerio": "^1.0.0",
    "composio-core": "0.4.8",
    "cron-parser": "5.5.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "7.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "google-auth-library": "11.0.2",
    "imapflow": "1.4.7",
    "ioredis": "^5.6.0",
    "jszip": "3.10.2",
    "mailparser": "3.12.4",
    "neverbounce": "5.0.5",
    "next": "16.4.2",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "node-ical": "0.25.6",
    "nodemailer": "10.2.1",
    "openai": "^4.0.0",
    "puppeteer": "24.35.0",
    "puppeteer-core": "24.35.0",
    "quoted-printable": "1.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remark-parse": "11.0.0",
    "rrweb": "2.1.4",
    "scrapybara": "2.5.2",
    "stripe": "^18.2.1",
    "svix": "1.97.0",
    "unified": "11.0.5",
    "unpdf": "1.8.1",
    "uuid": "^11.1.1",
    "workflow": "4.8.14",
    "ws": "^8.18.2",
    "zod": "^3.22.4",
    "zod-to-json-schema": "3.24.6"
  },
  "overrides": {
    "nanoid": "^5.1.16",
    "lodash-es": "^4.18.1",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "langium": "4.2.1",
    "yargs-parser": "^21.0.0",
    "devalue": "^5.6.2",
    "@puppeteer/browsers": "3.2.2",
    "@xmldom/xmldom": "0.9.12",
    "imapflow": {
      "nodemailer": "$nodemailer"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.7"
    },
    "katex": "^0.18.2",
    "qs": "6.16.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "^20.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/quoted-printable": "1.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "dotenv": "16.6.1",
    "jest": "^30.5.2",
    "pagefind": "^1.0.4",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.5",
    "ts-jest": "^29.4.15",
    "tsx": "4.21.0",
    "typescript": "^5.3.3"
  }
}
