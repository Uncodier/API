# API Key de servicio para comunicación interna
# Esta clave permite acceso completo a la API desde servicios internos
# sin necesidad de validación en la base de datos
SERVICE_API_KEY=your_internal_service_api_key_here

# Authenticates requests from Vercel Cron.
CRON_SECRET=your_cron_secret_here
# Maximum runtime for deterministic test evidence commands (milliseconds).
DECLARED_TEST_COMMAND_TIMEOUT_MS=180000

# Backward-compatible Redis URL used when the specialized URLs below are absent.
REDIS_URL=rediss://default:password@example.upstash.io:6379
# Evictable cache/control-plane Redis for caches, counters, and locks.
REDIS_CACHE_URL=rediss://default:password@cache-example.upstash.io:6379
# No-eviction Redis dedicated to durable tracking and recording streams.
REDIS_STREAMS_URL=rediss://default:password@streams-example.upstash.io:6379
# Optional cache REST credentials. The legacy UPSTASH_* names remain supported.
CACHE_UPSTASH_REDIS_REST_URL=https://cache-example.upstash.io
CACHE_UPSTASH_REDIS_REST_TOKEN=your_cache_upstash_rest_token
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
AI_STREAM_DB_CHECKPOINT_MS=2000
TRACKING_QUEUE_EVENTS_PER_RUN=500
TRACKING_QUEUE_MESSAGES_PER_RUN=100
TRACKING_QUEUE_MAX_PENDING_MESSAGES=100000
SESSION_RECORDING_QUEUE_MAX_MESSAGES=300
SESSION_RECORDING_SAMPLE_PERCENT=2
SESSION_RECORDING_MAX_ACTIVE_GLOBAL=500
SESSION_RECORDING_MAX_ACTIVE_PER_SITE=50
SESSION_RECORDING_MAX_GLOBAL_BYTES_PER_MINUTE=104857600
SESSION_RECORDING_MAX_SITE_BYTES_PER_MINUTE=20971520
SESSION_RECORDING_MAX_REQUESTS_PER_SESSION_MINUTE=120
API_MAX_REQUEST_BYTES=2097152
API_KEY_VALIDATION_REQUESTS_PER_MINUTE=300
API_KEY_VALIDATION_GLOBAL_REQUESTS_PER_MINUTE=2000
API_KEY_PRINCIPAL_REQUESTS_PER_MINUTE=600
SERVICE_API_KEY_REQUESTS_PER_MINUTE=5000
BEARER_VALIDATION_REQUESTS_PER_MINUTE=300
BEARER_VALIDATION_GLOBAL_REQUESTS_PER_MINUTE=2000
PUBLIC_IMAGE_READ_REQUESTS_PER_MINUTE=300
PUBLIC_IMAGE_READ_GLOBAL_REQUESTS_PER_MINUTE=10000
PUBLIC_GENERATION_GLOBAL_REQUESTS_PER_HOUR=200
PUBLIC_API_GLOBAL_REQUESTS_PER_MINUTE=1000
EXPENSIVE_API_GLOBAL_REQUESTS_PER_MINUTE=2000
TRACKING_GLOBAL_REQUESTS_PER_MINUTE=50000
VISITOR_SESSION_GLOBAL_REQUESTS_PER_MINUTE=500
WEBHOOK_GLOBAL_REQUESTS_PER_MINUTE=10000

# Clave de encriptación para API keys
ENCRYPTION_KEY=your_32_byte_encryption_key_here
VISITOR_SESSION_TOKEN_SECRET=your_separate_32_byte_session_signing_secret
# Dedicated identity HMAC secret: generate >=32 random bytes, never reuse another key.
VISITOR_IDENTITY_SIGNING_SECRET=
VISITOR_IDENTITY_SIGNING_KEY_ID=identity-v1
PUBLIC_MEDIA_SIGNING_SECRET=your_separate_32_byte_media_signing_secret

# Configuración de SMTP para emails
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=no-reply@example.com

# Configuración de filtros de seguridad para emails
# Lista de direcciones no-reply adicionales a bloquear (separadas por coma)
NO_REPLY_EMAILS=noreply@yourcompany.com,automated@yourcompany.com,system@yourcompany.com

# SendGrid API (opcional)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=Your Company

# URLs de la aplicación
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_ORIGIN=https://api.example.com
VERCEL_URL=your-vercel-url.vercel.app
# Optional prebuilt Vercel Sandbox image with agent-browser + Chrome for sub-second browser startup
AGENT_BROWSER_SNAPSHOT_ID=snap_your_agent_browser_snapshot_id

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key

# Google Cloud
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe

# Additional webhook signing secrets (requests fail closed when missing)
OUTSTAND_WEBHOOK_SECRET=your_outstand_webhook_secret
VERCEL_WEBHOOK_SECRET=your_vercel_webhook_secret
ZAVUDEV_WEBHOOK_SECRET=your_zavu_project_webhook_secret
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
GEAR_TWILIO_ACCOUNT_SID=your_twilio_account_sid
GEAR_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# AgentMail Webhook Signing Secrets
# Each webhook endpoint has its own signing secret for Svix signature verification
# Get these secrets from your AgentMail/Svix dashboard for each webhook endpoint
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_RECEIVED=whsec_your_webhook_secret_for_message_received
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_DELIVERED=whsec_your_webhook_secret_for_message_delivered
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_BOUNCED=whsec_your_webhook_secret_for_message_bounced
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_COMPLAINED=whsec_your_webhook_secret_for_message_complained
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_SENT=whsec_your_webhook_secret_for_message_sent
AGENTMAIL_WEBHOOK_SECRET_MESSAGE_REJECTED=whsec_your_webhook_secret_for_message_rejected
AGENTMAIL_WEBHOOK_SECRET_DOMAIN_VERIFIED=whsec_your_webhook_secret_for_domain_verified

# Supabase Auth Send Email Hook (Standard Webhooks)
# Dashboard → Auth → Hooks → Send Email → HTTPS URL: https://<api>/api/auth/send-email-hook
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_supabase_send_email_hook_secret

# Branding
UNCODIE_BRANDING_TEXT=Your Company, your AI Sales Team
UNCODIE_SUPPORT_EMAIL=support@example.com
UNCODIE_COMPANY_NAME=Your Company
UNCODIE_COMPANY_TAGLINE=AI-powered team collaboration

# Clave alternativa de encriptación (solo desarrollo)
ALT_ENCRYPTION_KEY=your_alt_encryption_key

# APIs de Screenshot (configurar al menos una)
SCREENSHOTMACHINE_API_KEY=your_screenshotmachine_api_key
SCREENSHOTLAYER_API_KEY=your_screenshotlayer_api_key
SCREENSHOTSCLOUD_KEY=your_screenshotscloud_key
SCREENSHOTSCLOUD_SECRET=your_screenshotscloud_secret

# Temporal Configuration
# Para desarrollo: solo configura TEMPORAL_ENV=development
TEMPORAL_ENV=development
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
WORKFLOW_TASK_QUEUE=default

# Para Temporal Cloud (opcional)
# TEMPORAL_CLOUD_API_KEY=your_temporal_cloud_api_key

# NeverBounce Email Validation
# Obten tu API key en: https://app.neverbounce.com/settings/api
NEVER_BOUNCE_API_KEY=your_neverbounce_api_key

# Primary AI gateway for chat, embeddings and video (server-only).
# Images, TTS and transcription use Azure directly. Set secrets in your deployment secret store.
# Setup and remaining model decisions: docs/OPENROUTER_MIGRATION.md
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Uncodie
OPENROUTER_CHAT_MODEL=openai/gpt-6.1-sol
# Selected Sora 2 base; no silent substitution with Pro. Requires catalog availability.
OPENROUTER_VIDEO_MODEL=openai/sora-2
# Direct Azure transcription: existing deployment, not an OpenRouter model ID.
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-transcribe
AZURE_OPENAI_TRANSCRIPTION_API_VERSION=2024-10-21
# Reuses MICROSOFT_AZURE_OPENAI_* below, then generic AZURE_OPENAI_* credentials.
# Dedicated overrides are optional; explicit empty overrides fail closed.
# AZURE_OPENAI_TRANSCRIPTION_ENDPOINT=
# AZURE_OPENAI_TRANSCRIPTION_API_KEY=
# No chat deployment/version inheritance or fallback to OpenRouter.

# TTS uses Azure directly with existing dedicated endpoint/key (both required).
# Endpoint: HTTPS Azure resource origin or /openai/v1/ base, not a full API URL.
# Resource/deployment must actually host Azure OpenAI TTS; no new resource is created.
AZURE_TTS_ENDPOINT=
AZURE_TTS_API_KEY=
# Optional defaults; omit to use defaults, but do not set empty overrides.
AZURE_TTS_DEPLOYMENT=tts-hd
AZURE_TTS_API_VERSION=2025-04-01-preview
# Azure OpenAI multilingual voice (including Spanish); never use MAI voice IDs.
AZURE_TTS_VOICE=alloy
# Uses dated /openai/deployments/{deployment}/audio/speech, even from /openai/v1/.
# Formats: mp3 (default), pcm, wav, opus, aac, flac. Input <=4096 chars; speed .25..4.
# No chat deployment/version or generic Azure credential inheritance; no OR fallback.
# Stale OPENROUTER_TTS_MODEL / OPENROUTER_TTS_VOICE settings are ignored.
# Live adapter MP3 check succeeded on existing tts-hd with 2025-04-01-preview.
# Earlier wrong-resource and 2024-10-21 checks returned 404. Use matched speech
# resource endpoint/key in server/CI; local updates are not production deployment.
# No storage/DB charge in smoke test; pronunciation/production acceptance still pending.

# Images and transcription use Azure directly. These aliases reuse existing secrets.
MICROSOFT_AZURE_OPENAI_ENDPOINT=
MICROSOFT_AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
AZURE_OPENAI_IMAGE_API_VERSION=preview
# Optional dedicated resource; if unset, use MICROSOFT_AZURE_OPENAI_* above,
# then AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY. Empty overrides fail closed.
# AZURE_OPENAI_IMAGE_ENDPOINT=
# AZURE_OPENAI_IMAGE_API_KEY=
# Never reuse a chat deployment/version or an OpenRouter model ID for images.

# Legacy AI_PROVIDER, AI_MODEL, AI_TTS_PROVIDER, AI_TRANSCRIPTION_PROVIDER,
# OPENROUTER_TTS_* and Google image/video models do not redirect provider routing.

# Forager API (Finder proxy)
FORAGER_API_KEY=your_forager_api_key
FORAGER_ACCOUNT_ID=your_forager_account_id